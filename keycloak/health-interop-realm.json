{
  "realm": "health-interop",
  "displayName": "Pflege Monitoring",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "client": {
      "monitoring-pflege-api": [
        {
          "name": "pflege_read",
          "description": "Patienten- und Pflegedaten lesen"
        },
        {
          "name": "pflege_write",
          "description": "Patienten- und Pflegedaten lesen und bearbeiten"
        },
        {
          "name": "pflege_delete",
          "description": "Patienten- und Observationen löschen"
        },
        {
          "name": "pflege_admin",
          "description": "Vollzugriff auf die Pflege-Monitoring-API"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "monitoring-pflege-api",
      "name": "Pflege Monitoring API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "monitoring-frontend",
      "name": "Pflege Monitoring Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${OIDC_REDIRECT_URI}"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "pflege-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "monitoring-pflege-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "pflege.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Pflege",
      "lastName": "Demo",
      "email": "pflege.demo@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": true
        }
      ],
      "clientRoles": {
        "monitoring-pflege-api": [
          "pflege_read",
          "pflege_write"
        ]
      }
    }
  ]
}
