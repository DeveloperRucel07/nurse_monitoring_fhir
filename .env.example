HAPI_DB_PASSWORD=replace-with-a-random-value
KEYCLOAK_NAME=admin
KEYCLOAK_PASSWORD=replace-with-a-random-value
KEYCLOAK_DB_PASSWORD=replace-with-a-random-value
OIDC_CLIENT_SECRET=replace-with-a-random-value
BFF_SESSION_ENCRYPTION_KEY=replace-with-a-fernet-key
DEMO_USER_PASSWORD=replace-with-a-random-value

# Public browser addresses for local development.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
APP_ORIGIN=http://localhost:8501
OIDC_REDIRECT_URI=http://localhost:8501/auth/callback
BFF_COOKIE_SECURE=false

# Optional FHIR client reliability limits.
FHIR_CONNECT_TIMEOUT=3.05
FHIR_READ_TIMEOUT=15
FHIR_RETRY_TOTAL=2
FHIR_MAX_RESPONSE_BYTES=10485760
FHIR_PAGE_SIZE=200
FHIR_MAX_PAGES=100
FHIR_MAX_SEARCH_RESOURCES=10000

# Disabled by default. Set explicitly to synthetic-demo only for demonstrations.
ML_MODE=disabled
